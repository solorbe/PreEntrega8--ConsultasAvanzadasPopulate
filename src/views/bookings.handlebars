<h1>Reservas</h1>
{{#each bookings}}
  <article>
    <h1>Reserva de {{this.clientName}}</h1>
    <p>Email: {{this.clientEmail}}</p>
    <p>Fecha: {{this.date}}</p>
    <p>Hora: {{this.time}}</p>
    <p>Estado: {{this.status}}</p>
    {{#each this.services}}
      <p>Servicio: {{this.service}}</p>
      <p>Cantidad: {{this.quantity}}</p>
    {{/each}}
  </article>
{{/each}}
